{
  "name": "jaza-packages",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "@jaza-node",
    "@jaza-react",
    "@jaza-react/example",
    "@jaza-react-native",
    "@jaza-react-native/example",
    "jaza-hero-demo"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "demo:hero": "npm run export:web -w jaza-hero-demo",
    "demo:hero:studio": "npm run studio -w jaza-hero-demo"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
